{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/owner/capability-contracts.schema.json",
  "title": "CapabilityContracts Owner Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ca-agent-host.capability-contracts/v1"
    },
    "kind": {
      "const": "CapabilityContracts"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "budgetExemptOperations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 512,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "owner",
        "operations"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Stable logical authorization/grouping identity granted by Skill source, qualified by dependency alias when needed."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/operation"
          },
          "description": "Exact callable Operations exposed under this Capability. Compiler rejects duplicate Operation IDs across all Capability entries."
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "effect"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Exact ToolCatalog Operation ID; not a Tool display name or inferred permission."
        },
        "effect": {
          "enum": [
            "READ",
            "MUTATION"
          ],
          "description": "Capability owner's expected Effect, independently cross-checked against ToolCatalog."
        }
      }
    }
  },
  "description": "Owner-published Capability membership contract. Each callable ToolCatalog Operation must occur in exactly one Capability entry; Compiler checks global membership uniqueness and independently declared Effect equality. Runtime remains responsible for deployment admission and authorization."
}
