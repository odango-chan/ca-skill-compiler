{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/v0.1/project-settings.schema.json",
  "title": "Skill Studio plugin-managed project configuration v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillsRoot",
    "dependencies",
    "dependencyLock"
  ],
  "properties": {
    "schemaVersion": {
      "const": "skillc.project/v0.1"
    },
    "skillsRoot": {
      "type": "string",
      "const": "skills"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "entries"
      ],
      "properties": {
        "version": {
          "const": "skillc.lock/v0.1"
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/lockEntry"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "repository",
            "path",
            "ref"
          ],
          "properties": {
            "type": {
              "const": "git"
            },
            "repository": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "upload",
            "contentDigest"
          ],
          "properties": {
            "type": {
              "const": "upload"
            },
            "upload": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "connectionId",
            "tools"
          ],
          "properties": {
            "type": {
              "const": "mcp"
            },
            "connectionId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "bundleId",
            "version"
          ],
          "properties": {
            "type": {
              "const": "builtin"
            },
            "bundleId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "tool-catalog",
            "schema-bundle"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "lockEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "snapshotDigest",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "tool-catalog",
            "schema-bundle"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resolvedRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2097152
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
