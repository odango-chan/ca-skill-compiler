{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/v0.1/build-request.schema.json",
  "title": "Skill Compiler host-independent BuildRequest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "sourceFiles",
    "resolvedDependencies"
  ],
  "properties": {
    "apiVersion": {
      "const": "skillc.build/v0.1"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "resolvedDependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/resolved"
      }
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)*$"
        },
        "bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "snapshotDigest",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "kind": {
          "enum": [
            "tool-catalog",
            "schema-bundle"
          ]
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    }
  }
}
