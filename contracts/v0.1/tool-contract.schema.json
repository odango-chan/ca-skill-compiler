{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/v0.1/tool-contract.schema.json",
  "title": "Normalized tool contract imported by Skill Compiler v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "operations"
  ],
  "properties": {
    "apiVersion": {
      "const": "skillc.tool/v0.1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "authority"
      ],
      "properties": {
        "classification": {
          "enum": [
            "UNKNOWN",
            "READ",
            "MUTATION"
          ]
        },
        "authority": {
          "enum": [
            "OWNER",
            "UNVERIFIED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "READ",
                  "MUTATION"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "authority": {
                "const": "OWNER"
              }
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "inputSchema",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "reconcileOutputSchema": {
          "type": "object"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    }
  }
}
