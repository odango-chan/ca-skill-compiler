{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/v0.1/dependency-inspection.schema.json",
  "title": "Compiler DependencyInspection result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostics",
    "tools"
  ],
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "path": {
          "type": "string",
          "maxLength": 240
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "dependencyId",
        "sourcePath",
        "declaredEffect",
        "inputSchema"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Path relative to the resolved dependency snapshot; no lib/ prefix."
        },
        "declaredEffect": {
          "enum": [
            "READ",
            "MUTATION"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "reconcileOutputSchema": {
          "type": "object"
        },
        "dependencyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]*$"
        }
      }
    }
  }
}
