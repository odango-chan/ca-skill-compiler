{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odango-chan/ca-skill-compiler/blob/main/contracts/v0.2/capability-contracts.schema.json",
  "title": "Agent Host CapabilityContracts v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ca-agent-host.capability-contracts/v1"
    },
    "kind": {
      "const": "CapabilityContracts"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "budgetExemptOperations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 512,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "owner",
        "operations"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "effect"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effect": {
          "enum": [
            "READ",
            "MUTATION"
          ]
        }
      }
    }
  }
}
