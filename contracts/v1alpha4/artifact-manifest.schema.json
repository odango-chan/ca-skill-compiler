{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:artifact:manifest:v1alpha4",
  "title": "Compiler Skill Artifact Manifest v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "languageTarget",
    "skill",
    "generator",
    "sourceFiles",
    "generatedFiles",
    "dependencyClosure"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/compiler-artifact/v1alpha4"
    },
    "languageTarget": {
      "const": "connectionagent.io/v1alpha4"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goal"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "ca-skill-compiler"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "commit": {
          "type": "string",
          "minLength": 7,
          "maxLength": 64
        }
      }
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^skills/"
      }
    },
    "generatedFiles": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^skills/"
      }
    },
    "dependencyClosure": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependencyId",
          "stablePackageId",
          "exports"
        ],
        "properties": {
          "dependencyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "stablePackageId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          },
          "exports": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "exportKind",
                "exportId",
                "owner"
              ],
              "properties": {
                "exportKind": {
                  "enum": [
                    "operation",
                    "observation",
                    "schema",
                    "evidenceGuarantee"
                  ]
                },
                "exportId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  }
}
