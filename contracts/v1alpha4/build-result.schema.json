{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:compiler-api:build-result:v1alpha4",
  "title": "Compiler BuildResult v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "success",
    "diagnostics",
    "dependencyClosure",
    "outputFiles"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/compiler-build-result/v1alpha4"
    },
    "success": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "phase",
          "path",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "phase": {
            "enum": [
              "C_STATIC",
              "C_WARNING"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "C_STATIC"
                }
              },
              "required": [
                "phase"
              ]
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "C_WARNING"
                }
              },
              "required": [
                "phase"
              ]
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        ]
      }
    },
    "dependencyClosure": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "outputFiles": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^skills/"
          },
          "bytes": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 2796204
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": false
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "dependencyClosure": {
            "maxItems": 0
          },
          "outputFiles": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "diagnostics": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        },
        "required": [
          "diagnostics"
        ]
      },
      "then": {
        "properties": {
          "success": {
            "const": false
          },
          "outputFiles": {
            "maxItems": 0
          },
          "dependencyClosure": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
