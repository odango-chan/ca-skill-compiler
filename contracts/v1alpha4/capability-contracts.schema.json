{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:deployment-contract:capability-contracts:v1alpha4",
  "title": "CapabilityContracts v1alpha4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/capability-contracts/v1alpha4"
    },
    "kind": {
      "const": "CapabilityContracts"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "callables"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "callables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/callable"
          },
          "uniqueItems": true
        }
      }
    },
    "callable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "id",
        "kind",
        "effect"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*$"
        },
        "kind": {
          "enum": [
            "operation",
            "observation"
          ]
        },
        "effect": {
          "enum": [
            "READ",
            "MUTATION"
          ]
        },
        "scopePolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "description": "Deployment-side authorization input. Compiler validates exact callable identity, kind and Effect; a granted member must resolve a trusted Scope policy. Capability membership is not inferred from ToolCatalog."
}
