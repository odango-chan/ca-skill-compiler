{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:development:interface-dependency-lock:v1alpha1",
  "title": "CA Skill Compiler Development interface-dependency-lock v1alpha1 (DRAFT)",
  "description": "Resolver-produced exact immutable package graph; no version resolution by Compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "roots",
    "packages"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/interface-dependency-lock/v1alpha1"
    },
    "roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockRoot"
      },
      "minItems": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockPackage"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "packageKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "version",
        "snapshotDigest"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "lockRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "key"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "$ref": "#/$defs/packageKey"
        }
      }
    },
    "lockEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "key"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "$ref": "#/$defs/packageKey"
        }
      }
    },
    "lockPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "dependencies"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/packageKey"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockEdge"
          }
        }
      }
    }
  }
}
