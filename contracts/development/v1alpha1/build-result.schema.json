{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:development:build-result:v1alpha1",
  "title": "CA Skill Compiler Development build-result v1alpha1 (DRAFT)",
  "description": "A failed Development Build returns no artifact bytes or digest. A successful artifact remains NOT_ADMITTED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "success",
    "sourceStatus",
    "interfaceLinkStatus",
    "artifactStatus",
    "executionStatus",
    "diagnostics",
    "outputFiles"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/compiler-development-build-result/v1alpha1"
    },
    "success": {
      "type": "boolean"
    },
    "sourceStatus": {
      "enum": [
        "VALIDATED",
        "FAILED",
        "NOT_RUN"
      ]
    },
    "interfaceLinkStatus": {
      "enum": [
        "LINKED",
        "FAILED",
        "NOT_RUN"
      ]
    },
    "artifactStatus": {
      "enum": [
        "BUILT",
        "FAILED",
        "NOT_RUN"
      ]
    },
    "executionStatus": {
      "const": "NOT_ADMITTED"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "outputFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "phase",
        "code",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "required": [
          "artifactDigest"
        ],
        "properties": {
          "sourceStatus": {
            "const": "VALIDATED"
          },
          "interfaceLinkStatus": {
            "const": "LINKED"
          },
          "artifactStatus": {
            "const": "BUILT"
          },
          "outputFiles": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "artifactDigest"
          ]
        },
        "properties": {
          "outputFiles": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
