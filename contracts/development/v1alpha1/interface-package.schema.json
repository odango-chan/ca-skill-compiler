{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-skill-compiler:development:interface-package:v1alpha1",
  "title": "CA Skill Compiler Development interface-package v1alpha1 (DRAFT)",
  "description": "Immutable package manifest. The publisher is a declared identity, not a Host-verified Owner trust decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "packageId",
    "version",
    "languageTarget",
    "publisher",
    "dependencies",
    "exports",
    "files"
  ],
  "properties": {
    "apiVersion": {
      "const": "connectionagent.io/interface-package/v1alpha1"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "languageTarget": {
      "const": "connectionagent.io/v1alpha5"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "packageId",
        "version"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CallableCatalog",
            "Schema",
            "CapabilityCatalog",
            "IngressCatalog",
            "EvidenceDescriptor"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifactBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactBinding"
          }
        },
        "schemaBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaBinding"
          }
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "dependencyId",
        "snapshotPath",
        "dialect"
      ],
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "dependencyId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotPath": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportId",
        "artifactRef"
      ],
      "properties": {
        "exportId": {
          "type": "string",
          "minLength": 1
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        }
      }
    }
  }
}
