  "cards": [
    {
      "dot": "cyan",
      "title": "session-demo：AMF 经 SCP 发来的 Create（结构示意，非完整报文）",
      "items": [
        "POST /nsmf-pdusession/v1/sm-contexts  HTTP/2",
        "JSON：pduSessionId=10，dnn=internet，sNssai={sst:1}",
        "JSON：n1SmMsg = { contentId: \"n1-part\" }",
        "multipart 附件 n1-part：原始 N1 NAS 字节",
        "SCP 的下一跳是 Host apiRoot；AMF 不直连 Host"
      ]
    },
    {
      "dot": "emerald",
      "title": "解码后交给 Skill 的类型化请求（示意，非 CA-SL 语法）",
      "items": [
        "request.pduSessionId = 10（来自 SBI JSON）",
        "request.dnn = internet（来自 SBI JSON）",
        "request.sNssai.sst = 1（来自 SBI JSON）",
        "request.pti / requestedPduSessionType / requestedSscMode（来自 NAS 解码）",
        "每个字段保留来源，原始 N1 不进 Skill 参数"
      ]
    },
    {
      "dot": "rose",
      "title": "N1 的两条路径必须分开",
      "items": [
        "路径 A（已设计）：原始 N1 → Artifact Store → 只读 Codec → 类型化字段 → Skill",
        "路径 B（未实现，虚线）：原始 N1 → Owner-private 绑定 → OpenAMSM GSM Handler",
        "只做路径 A 不能宣称 NAS 语义保真的 E2E"
      ]
    },
    {
      "dot": "amber",
      "title": "路由闭环与已知缺口",
      "items": [
        "Create 的 201 Location 指向 Host；后续 Update / Release 仍回到同一 Host 资源",
        "Host → Owner 是同一逻辑 SMF 的内部受信绑定，不再经 SCP 形成环路",
        "OpenAMSM 仍是唯一 Nsmf 服务发布者；Host 与 Owner 冲突注册未验收",
        "Owner Pending、Reconcile proof、NRF 双地址策略均未完成"
      ]
    },
    {
      "dot": "slate",
      "title": "责任域（代码与职责归属，不是进程部署）",
      "items": [
        "CA-Agent（ca-agent-demo）：Listener、SBI Decoder、Artifact Store、Typed Context、Router、URI Map、Runtime、Namf Relay",
        "CA Client Tools（ca-client-tools）：只读 5GSM Codec、固定 MAS/Nsmf/Namf Egress；可独立部署，不是 AMF 入站 Listener",
        "OpenAMSM（env-openamsm）：SMF Owner、GSM/NAS Handler、Session/Policy/Charging 状态、PFCP Client、Namf 请求生产方",
        "外部 5GC：AMF、SCP、NRF、UDM/PCF/CHF、UPF（UPF 是 N4 Peer，不在 SMF 进程内）"
      ]
    }
  ]
