  "cards": [
    {
      "dot": "cyan",
      "title": "三条路径各自定版（session-demo 贯穿）",
      "items": [
        "接口：Interface Package（含 Capability Catalog）→ 锁 + 精确快照，只有锁进 Compiler",
        "实现：Runtime Provider Package 不进 Compiler，只以精确接口键进入 Host 绑定",
        "授权：Deployment Grant 由部署方独立签发，Resolver 与 Compiler 都看不到"
      ]
    },
    {
      "dot": "rose",
      "title": "什么时候才允许执行",
      "items": [
        "构建成功不等于可执行：产物一律 NOT_ADMITTED",
        "隔离开发 Host 需显式 opt-in + 实测 Grant；生产 Host 一律拒收 DEVELOPMENT",
        "结果未知时保留原尝试并走受控 Reconcile，不把重试当作成功"
      ]
    },
