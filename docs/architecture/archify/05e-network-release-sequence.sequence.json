  "cards": [
    {
      "dot": "cyan",
      "title": "网络触发源",
      "items": [
        "PCF-initiated：PCF → SCP → OpenAMSM callback；SMF-local：OpenAMSM 自身 timer / decision",
        "OpenAMSM 再通过受信 scoped event 把准确 Session 与 trigger generation 交给 Host",
        "网络侧释放不是 AMF 新建 SM Context；Host 只定位既有资源"
      ]
    },
    {
      "dot": "emerald",
      "title": "Release 与回执",
      "items": [
        "按 OES r1（optional）→ r2 → r3 → r4 → r5 → r6 组织 Owner 生命周期",
        "r3 产生的 Namf 请求必须走 Host Relay → Client Tools → SCP → AMF",
        "AMF 后续 Update / Release 回到 Host Location，并被关联到原 r3 occurrence；不能启动第二个 Release Run"
      ]
    },
    {
      "dot": "slate",
      "title": "网络路径约束",
      "items": [
        "PCF callback、Npcf policy deletion 和 Namf transfer 均经 SCP",
        "PFCP Type 54/55 由 OpenAMSM 直连 UPF，不经过 SCP",
        "Host 负责对外 URI 与资源 tombstone；OpenAMSM 是 SMF Session / Policy / N4 的权威 Owner"
      ]
    }
